# Copy to .env (repo root) and fill in real values. Never commit .env.
# Every variable is required: the backend refuses to start if one is missing.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
DATABASE_URL=postgresql://user:pass@localhost:5432/dataclarity
# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
MODEL_REASONING=claude-sonnet-5
MODEL_BULK=claude-haiku-4-5
MAX_UPLOAD_MB=50
RUNS_DIR=runs
RETENTION_HOURS=24
# Parsed CSVs kept in memory so the preview does not re-read the file on every edit.
# MAX_MB = memory the cached files may use together (a 50 MB file parses to about
# 100 MB, so 300 holds three). TTL = seconds a file may sit unused before it is dropped.
PREVIEW_CACHE_MAX_MB=300
PREVIEW_CACHE_TTL_SECONDS=900
# Frontend (read by Vite from this same file; only VITE_* reaches the browser)
VITE_API_BASE_URL=http://localhost:8000
